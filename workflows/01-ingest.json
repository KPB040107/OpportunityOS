      "parameters": {
        "jsCode": "const response=$input.first().json; const body=response.body; if(response.statusCode!==200 || typeof body?.id!=='string' || !/^[0-9a-f-]{36}$/i.test(body.id)) return [{json:{valid:false,http_status:response.statusCode===401||response.statusCode===403?401:503,error:'Session verification failed'}}]; const input=$('Validate the intake contract').first().json; return [{json:{valid:true,user_id:body.id,request_id:input.request_id,source_type:input.source_type,content:input.content}}];"
      }
