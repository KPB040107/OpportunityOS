      "id": "ingest-note",
      "name": "Ingest boundary",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -400
      ],
      "parameters": {
        "content": "## Ingest — verify → save → confirm → Understand\nOwnership comes from Supabase Auth, never the request body. Database writes and activity logging are atomic. Repeated request IDs return the existing item. Confirm the save before starting asynchronous analysis; its queue checker also recovers a missed dispatch. Session data is removed from the child input. Execution data is not retained because the request contains a user session token. Configure the fixed Supabase Auth URL, public API key and Postgres credential.",
        "height": 260,
        "width": 620
      }
    }
