{
  "id": "opportunityosSlice5Autopilot",
  "name": "OpportunityOS 06 Autopilot",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 480,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "timezone": "Asia/Kolkata",
    "errorWorkflow": "opportunityosSlice5ErrorHandler"
  },
  "nodes": [
    {
      "id": "daily",
      "name": "Scan every day at nine IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "trigger",
      "name": "Run a controlled daily scan",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        160
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "manual",
      "name": "Rehearse the daily scan",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -160
      ],
      "parameters": {}
    },
    {
      "id": "scan",
      "name": "Queue owned reminders and record each user heartbeat",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_prepare_autopilot() as result;",
        "options": {}
      }
    },
    {
      "id": "summary",
      "name": "Return honest queued counts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i=>({json:{...i.json.result,delivery:\"Queued actions are not completed deliveries\"}}));"
      }
    },
    {
      "id": "note",
      "name": "Autopilot delivery boundary",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        -340
      ],
      "parameters": {
        "content": "## Daily at 09:00 Asia/Kolkata\nProcess every user; queue deadline reminders and due follow-ups with stable keys. The Act worker leases each job, sends from the agent mailbox, and records actual results. Follow-ups remain pending until the side effect succeeds. Quota/profile/day changes remain fenced. A heartbeat confirms the scan, not email delivery.",
        "width": 900,
        "height": 180
      }
    }
  ],
  "connections": {
    "Scan every day at nine IST": {
      "main": [
        [
          {
            "node": "Queue owned reminders and record each user heartbeat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run a controlled daily scan": {
      "main": [
        [
          {
            "node": "Queue owned reminders and record each user heartbeat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rehearse the daily scan": {
      "main": [
        [
          {
            "node": "Queue owned reminders and record each user heartbeat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Queue owned reminders and record each user heartbeat": {
      "main": [
        [
          {
            "node": "Return honest queued counts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
