{
  "id": "opportunityosSlice4Ask",
  "name": "OpportunityOS 05 Ask and Approve",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 172900,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "timezone": "Asia/Kolkata",
    "errorWorkflow": "opportunityosSlice5ErrorHandler"
  },
  "nodes": [
    {
      "id": "trigger",
      "name": "Ask about the saved match",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "review-recovery",
      "name": "Recover saved ASK decisions without a review",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "review-candidate",
      "name": "Find one current missing review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        -180
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select m.id as match_id from public.matches m join public.opportunities o on o.id=m.opportunity_id and o.user_id=m.user_id where m.status='complete' and m.decision='ASK' and (o.deadline is null or o.deadline>(now() at time zone 'Asia/Kolkata')::date) and not exists(select 1 from public.approvals a where a.match_id=m.id and a.match_revision=m.revision) order by m.updated_at limit 1;",
        "options": {}
      }
    },
    {
      "id": "review-context",
      "name": "Load current owned review context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_match_context($1::uuid,$2::text,'05-ask') as result;",
        "options": {
          "queryReplacement": "={{ [$json.match_id,$execution.id] }}"
        }
      }
    },
    {
      "id": "approval",
      "name": "Bind the private waiting execution",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        460,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_create_approval($1::uuid,$2::text,$3::text) as result;",
        "options": {
          "queryReplacement": "={{ [$json.result.match_id,$execution.id,$execution.resumeUrl.replace(/^https?:[/][/][^/]+/,\"http://localhost:5678\")] }}"
        }
      }
    },
    {
      "id": "unpack",
      "name": "Stop duplicate approval executions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "jsCode": "const c=$input.first().json.result;return c?.created?[{json:c}]:[];"
      }
    },
    {
      "id": "wait",
      "name": "Wait for authenticated confirmation",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        750,
        0
      ],
      "parameters": {
        "resume": "webhook",
        "incomingAuthentication": "headerAuth",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {},
        "limitWaitTime": true,
        "limitType": "atSpecifiedTime",
        "maxDateAndTime": "={{ $json.expires_at }}"
      }
    },
    {
      "id": "resume-body",
      "name": "Require the private resume nonce",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "const body=$input.first().json.body;return body&&/^[0-9a-f-]{36}$/.test(body.approval_id)&&/^[0-9a-f-]{36}$/.test(body.nonce)?[{json:body}]:[];"
      }
    },
    {
      "id": "consume",
      "name": "Check saved outcome revision and eligibility",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_consume_resume($1::uuid,$2::text,$3::uuid) as result;",
        "options": {
          "queryReplacement": "={{ [$json.approval_id,$execution.id,$json.nonce] }}"
        }
      }
    },
    {
      "id": "approved",
      "name": "Continue only verified permitted approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.result;return r.approved?[{json:{match_id:r.match_id}}]:[];"
      }
    },
    {
      "id": "act",
      "name": "Resume permitted actions",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1750,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "opportunityosSlice4Act",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    },
    {
      "id": "poll",
      "name": "Recover pending confirmation deliveries",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "resume-claim",
      "name": "Claim one pending private resume",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_claim_resume() as result;",
        "options": {}
      }
    },
    {
      "id": "resume-unpack",
      "name": "Keep resume capabilities server side",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        240
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.result;return r.claimed?[{json:r}]:[];"
      }
    },
    {
      "id": "resume-http",
      "name": "Resume the same authenticated Wait execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({approval_id:$json.approval_id,nonce:$json.nonce}) }}",
        "options": {
          "timeout": 5000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "resume-result",
      "name": "Record delivery attempt without claiming completion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select public.worker_resume_attempt($1::uuid,$2::boolean);",
        "options": {
          "queryReplacement": "={{ [$(\"Keep resume capabilities server side\").first().json.approval_id,$json.statusCode === 200] }}"
        }
      }
    },
    {
      "id": "note",
      "name": "Authenticated approval boundary",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        280,
        -280
      ],
      "parameters": {
        "content": "## Review → explicit signed-in confirmation → private resume → reevaluation gate\nEmail points to an authenticated confirmation page, never a resume URL. UNKNOWN requires corrected facts and reevaluation. Approval expires at 48 hours or the deadline, whichever is first. Revision changes, replay, rejection and timeout cannot authorize actions. The resume nonce and Header Auth credential stay server-side; only the waiting execution can consume the decision. Queued resume is not displayed as completed.",
        "width": 1200,
        "height": 190
      }
    }
  ],
